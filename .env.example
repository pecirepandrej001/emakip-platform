APP_NAME=EMAKIP
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=emakip
POSTGRES_PASSWORD=emakip
POSTGRES_DB=emakip
DATABASE_URL=postgresql+asyncpg://emakip:emakip@postgres:5432/emakip

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=emakip_documents

MLFLOW_TRACKING_URI=http://mlflow:5000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emakip

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K=8
RERANK_TOP_K=4
CHUNK_SIZE=700
CHUNK_OVERLAP=100

API_BASE_URL=http://api:8000
